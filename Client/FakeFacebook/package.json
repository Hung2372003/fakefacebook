{
  "name": "facebook-desktopapp",
  "version": "1.0.0",
  "description": "Ứng dụng Facebook Desktop",
  "main": "app.js",
  "scripts": {
    "ng": "ng",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:ang-electron": "node dist/ang-electron/server/server.mjs",
    "start": "ng build  --configuration production --base-href ./ && electron --trace-warnings .",
    "build": "ng build --configuration production --base-href ./",
    "pack": "electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "private": true,
  "dependencies": {
    "@angular-devkit/core": "^19.0.6",
    "@angular/animations": "^19.0.5",
    "@angular/cdk": "^19.0.4",
    "@angular/common": "^19.0.5",
    "@angular/compiler": "^19.0.5",
    "@angular/core": "^19.0.5",
    "@angular/forms": "^19.0.5",
    "@angular/material": "^19.0.4",
    "@angular/platform-browser": "^19.0.5",
    "@angular/platform-browser-dynamic": "^19.0.5",
    "@angular/platform-server": "^19.0.5",
    "@angular/router": "^19.0.5",
    "@angular/ssr": "^19.0.6",
    "@fortawesome/fontawesome-free": "^6.6.0",
    "@microsoft/signalr": "^8.0.7",
    "@ng-bootstrap/ng-bootstrap": "^18.0.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "electron-store": "^10.0.0",
    "express": "^4.18.2",
    "imagesloaded": "^5.0.0",
    "isotope-layout": "^3.0.6",
    "ngx-cookie-service": "^19.0.0",
    "rcedit": "^4.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "ws": "^8.18.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.6",
    "@angular/cli": "^19.0.6",
    "@angular/compiler-cli": "^19.0.5",
    "@angular/localize": "^19.0.5",
    "@fullhuman/postcss-purgecss": "^6.0.0",
    "@types/aos": "^3.0.7",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "clean-webpack-plugin": "4.0.0",
    "css-loader": "7.1.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "html-webpack-plugin": "5.6.3",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "mini-css-extract-plugin": "2.9.2",
    "sass": "^1.83.1",
    "ts-loader": "9.5.1",
    "typescript": "~5.5.2",
    "webpack": "5.96.1",
    "webpack-cli": "5.1.4"
  },
  "build": {
    "appId": "com.example.myapp",
    "productName": "Facebook Desktop",
    "win": {
      "icon": "public/facebook.256x256.ico",
      "target": [
        "nsis"
      ]
    },
    "files": [
      "dist/**/*",
      "app.js"
    ],
    "directories": {
      "output": "dist_electron"
    }
  }
}